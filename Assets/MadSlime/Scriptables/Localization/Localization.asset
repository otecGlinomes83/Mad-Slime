  - _key: reset_warning
    _ru: "\u0411\u0443\u0434\u0435\u0442 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u043E
      \u0410\u0411\u0421\u041E\u041B\u042E\u0422\u041D\u041E \u0412\u0421\u0401!\n\n\u0423\u0440\u043E\u0432\u043D\u0438,
      \u0434\u0435\u043D\u044C\u0433\u0438, \u0432\u0441\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435
      \u0441\u043A\u0438\u043D\u044B, \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F,
      \u043F\u043E\u043A\u0443\u043F\u043A\u0438, \u0440\u0443\u043B\u0435\u0442\u043A\u0430
      \u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0430.\n\n\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u043D\u0435\u043B\u044C\u0437\u044F."
    _en: 'ABSOLUTELY ALL progress will be reset!


      Levels, money, all unlocked
      skins, upgrades, purchases, roulette and statistics.


      This cannot be
      undone.'
    _tr: "T\xDCM ilerleme s\u0131f\u0131rlanacak!\n\nSeviyeler, para, a\xE7\u0131lan
      t\xFCm g\xF6r\xFCn\xFCmler, geli\u015Ftirmeler, sat\u0131n al\u0131mlar, \xE7ark
      ve istatistikler.\n\nBu i\u015Flem geri al\u0131namaz."
  - _key: reset_cancel
    _ru: "\u041D\u0435\u0442, \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
    _en: No, keep it
    _tr: "Hay\u0131r, koru"
  - _key: reset_confirm
    _ru: "\u0414\u0430, \u0441\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
    _en: Yes, reset
    _tr: "Evet, s\u0131f\u0131rla"
  - _key: upgrades_skills
    _ru: "\u041D\u0410\u0412\u042B\u041A\u0418"
    _en: SKILLS
    _tr: YETENEKLER
