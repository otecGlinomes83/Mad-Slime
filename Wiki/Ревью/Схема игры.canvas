		{"id":"113f35e7b6065d22","type":"text","text":"показать эффект заполнения","x":562,"y":3120,"width":250,"height":60,"color":"4"},
		{"id":"efd34745993345ea","type":"text","text":"Включить музыку","x":562,"y":2080,"width":250,"height":60,"color":"4"},
		{"id":"eda3152daf68aa4f","type":"text","text":"Инициализация Систем","x":562,"y":2180,"width":250,"height":60,"color":"4"},
